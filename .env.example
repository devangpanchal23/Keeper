# ==============================================================================
# RECALL APPLICATION — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT:
# NEVER commit .env, .env.local, or real production secrets to version control.
# Production secrets should only be configured in GitHub Secrets / Vercel Dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
# Canonical URL of the deployed application (used for CORS, metadata, and smoke tests)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Generate a random server-only key with: openssl rand -base64 48
# Used to enforce a fixed seven-day maximum across Supabase token refreshes.
AUTH_SESSION_SECRET=""

# Server-side storage backend. Values: supabase (default), postgres, mongodb.
# Keep connection strings private; never prefix them with NEXT_PUBLIC_.
DATABASE_PROVIDER="supabase"
DATABASE_URL=""
MONGODB_URI=""
MONGODB_DATABASE="keeper"
DATABASE_POOL_MAX="10"

# Optional: 3D interactive hero animation scene URL from Spline
# If left blank, the application gracefully renders high-performance SVG visual fallbacks
NEXT_PUBLIC_SPLINE_HERO_URL=""

# ------------------------------------------------------------------------------
# 2. PLATFORM INGESTION & SECRETS (SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT)
# ------------------------------------------------------------------------------
# Optional: YouTube Data API v3 key for server-side channel, tag, & duration extraction
# If unset, Keeper seamlessly uses high-performance oEmbed & direct CDN thumbnails
YOUTUBE_API_KEY=""

# Optional: Meta Graph API App Access Token for Instagram oEmbed API
# If unset, Keeper utilizes captioned embed extraction and OpenGraph metadata parsing
INSTAGRAM_OEMBED_TOKEN=""
META_APP_ACCESS_TOKEN=""

# Razorpay test-mode API credentials (server-side only; never add secrets to NEXT_PUBLIC_*).
# Test mode is the default. Live mode requires RAZORPAY_MODE=live and ALLOW_REAL_RAZORPAY_PAYMENTS=true.
RAZORPAY_MODE="test"
ALLOW_REAL_RAZORPAY_PAYMENTS="false"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Required for server-only billing table writes. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Self-hosted faster-whisper HTTP service used by the asynchronous media worker.
# The service must accept raw audio bytes (application/octet-stream) and return
# JSON: { text, language?, segments?: [{ start, end, text, confidence? }] }.
WHISPER_SERVICE_URL=""
WHISPER_MODEL="large-v3"
WHISPER_SERVICE_TOKEN=""
# Select `gemini`, `openai`, `faster-whisper`, or `auto` (Gemini when configured, then OpenAI, then faster-whisper).
TRANSCRIPTION_PROVIDER="auto"
# Optional secondary provider used only for transient provider errors/timeouts.
TRANSCRIPTION_FALLBACK="deepgram"
GEMINI_API_KEY=""
DEEPGRAM_API_KEY=""
# Server-side OpenAI Speech-to-Text. Defaults to whisper-1; override with a supported transcription model.
OPENAI_TRANSCRIPTION_API_KEY=""
OPENAI_TRANSCRIPTION_MODEL="whisper-1"
# Optional separate URL for the authenticated FFmpeg /extract-audio sidecar endpoint.
# If omitted, the endpoint is derived from WHISPER_SERVICE_URL by replacing /transcribe with /extract-audio.
AUDIO_EXTRACTION_SERVICE_URL=""
# Content understanding provider (gemini or openai-compatible, server-side only).
# Without these values the worker fails analysis explicitly and generates no AI output.
CONTENT_AI_PROVIDER="gemini"
CONTENT_AI_API_URL="https://api.openai.com/v1/chat/completions"
CONTENT_AI_API_KEY=""
CONTENT_AI_MODEL="gemini-3.8-flash"
# OPENAI_API_KEY may be shared by STT and analysis when dedicated keys are not set.
OPENAI_API_KEY=""
# Optional private Tesseract/FFmpeg OCR service for images and video frames.
# Service contract and Docker deployment: services/ocr/README.md
OCR_SERVICE_URL=""
OCR_SERVICE_TOKEN=""
# Protects /api/ai/worker; configure the same value in Vercel and GitHub Actions.
AI_WORKER_SECRET=""

# Server-side AES-256 token encryption secret for OAuth credentials
TOKEN_ENCRYPTION_KEY=""

# ------------------------------------------------------------------------------
# 3. CI/CD DEPLOYMENT SECRETS (GITHUB SECRETS ONLY — NOT LOCAL .ENV)
# ------------------------------------------------------------------------------
# VERCEL_TOKEN: Personal / Team access token generated from Vercel Account Settings
# VERCEL_ORG_ID: Found in project settings or .vercel/project.json
# VERCEL_PROJECT_ID: Found in project settings or .vercel/project.json
